# MercadoPago — credenciales de PRUEBA (sandbox)
# Sacalas de: mercadopago.com.ar/developers → Tus integraciones → tu app → Credenciales de prueba
# El Access Token de prueba empieza con TEST-...
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx

# Asistente IA — API key de Anthropic (console.anthropic.com, pago por uso)
# Empieza con sk-ant-...
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# URL base del sitio (para las URLs de retorno tras el pago)
# Local: http://localhost:3000 — Producción: https://sanitarios-baez.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
